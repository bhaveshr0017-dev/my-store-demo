{
  "public": {
    "default": {
      "commerce-endpoint": "https://na1-sandbox.api.commerce.adobe.com/LnmAoxen7MwsAyRYdvVzTE/graphql",

      "headers": {
        "all": {
          "Store": "default"
        },
        "cs": {
          "Magento-Website-Code": "base",
          "Magento-Store-Code": "main_website_store",
          "Magento-Store-View-Code": "default"
        }
      },

      "commerce-b2b-enabled": false,
      "commerce-companies-enabled": false,
      "commerce-assets-enabled": true,
      "adobe-commerce-optimizer": false,

      "analytics": {
        "environment": "Testing",
        "environment-id": "LnmAoxen7MwsAyRYdvVzTE",

        "website-code": "base",
        "website-id": "base",
        "website-name": "Main Website",

        "store-code": "main_website_store",
        "store-id": "main_website_store",
        "store-name": "Main Website Store",

        "store-view-code": "default",
        "store-view-id": "default",
        "store-view-name": "Default Store View",

        "base-currency-code": "USD"
      },

      "plugins": {
        "picker": {
          "rootCategory": "2"
        },
        "commerce": {
          "enabled": true
        },
        "liveSearch": {
          "enabled": false
        }
      },

      "features": {
        "wishlist": true,
        "cart": true,
        "checkout": true,
        "account": true,
        "search": true,
        "compare": false
      }
    }
  }
}